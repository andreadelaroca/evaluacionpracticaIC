<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="500.0" prefWidth="600.0" spacing="15.0"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.evaluacionpracticaic.controller.Formulario2Controller">
    <children>
        <Label text="Listado de Empleados" textFill="#0066cc">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>

        <TableView fx:id="tblEmpleados" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colNombres" prefWidth="140.0" text="Nombres" />
                <TableColumn fx:id="colApellidos" prefWidth="140.0" text="Apellidos" />
                <TableColumn fx:id="colCargo" prefWidth="160.0" text="Cargo" />
                <TableColumn fx:id="colSalario" prefWidth="100.0" text="Salario" />
            </columns>
        </TableView>

        <HBox spacing="15.0">
            <Button fx:id="btnRegresar" prefHeight="40.0" prefWidth="120.0" text="Regresar" />
        </HBox>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>